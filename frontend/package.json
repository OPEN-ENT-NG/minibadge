{
  "name": "minibadge",
  "version": "1.0.0-dev.0",
  "description": "Badge assignment application for ENT Core.",
  "license": "AGPL-3.0",
  "author": "Edifice",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build && vite build --config vite.sniplet.config.ts",
    "build:sniplet": "vite build --config vite.sniplet.config.ts",
    "dev": "vite",
    "dev:sniplet": "vite build --config vite.sniplet.config.ts --watch",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@edifice.io/bootstrap": "2.2.4",
    "@edifice.io/client": "2.2.4",
    "@edifice.io/react": "2.2.4",
    "@react-spring/web": "9.7.5",
    "@tanstack/react-query": "5.62.7",
    "apexcharts": "4.7.0",
    "i18next": "23.8.1",
    "i18next-http-backend": "2.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.0.13",
    "react-i18next": "14.1.0",
    "react-router-dom": "6.30.3",
    "react-apexcharts": "1.7.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "18.19.130",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0-rc.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "msw": "2.12.8",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "5.4.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": "18 || 20"
  }
}
